// Plinth — Database Schema
// Format: DBML (dbdiagram.io)
// Source of truth: plinth/db/migrations/

Project plinth {
  database_type: 'PostgreSQL'
  Note: 'On-demand site intelligence reports. PostGIS enabled.'
}

// ─── Migration Tracking ──────────────────────────────────────────────────────

Table schema_migrations {
  version    text        [pk]
  applied_at timestamptz [default: `now()`]

  Note: 'Managed by plinth/db/__init__.py. One row per applied .sql file.'
}

// ─── Phase 1: Foundation ─────────────────────────────────────────────────────

Table data_source_registry {
  source_name      text        [pk, note: 'e.g. fema-nfhl, usgs-3dep, census-tiger']
  dataset_version  text        [note: 'e.g. 2024-01, 2023']
  last_downloaded  timestamptz
  update_frequency text        [note: 'monthly | annual | decadal']
  next_review_date date
  coverage_region  text        [note: 'ne-oklahoma | oklahoma | national']
  notes            text

  Note: 'One row per data source. Upserted by each ingestor register() call.'
}

Table raster_tiles {
  id              serial      [pk]
  dataset         text        [not null, note: 'e.g. usgs-3dep, nlcd, usgs-seismic']
  s3_key          text        [not null, unique, note: 'MinIO key: {dataset}/{version}/{tile_id}.tif']
  bounds          geometry    [not null, note: 'Polygon, SRID 4326 — spatial index via GIST']
  resolution_m    numeric     [note: '~10 for USGS 3DEP, ~30 for NLCD']
  tile_id         text        [note: 'e.g. n37w096']
  dataset_version text
  created_at      timestamptz [default: `now()`]

  indexes {
    bounds [type: gist, name: 'raster_tiles_bounds_idx']
    dataset [name: 'raster_tiles_dataset_idx']
  }

  Note: 'Spatial index of COG tiles stored in MinIO. PostGIS holds bounds only — raster data lives in MinIO.'
}

Table query_cache {
  cache_key   text        [pk, note: 'Dataset-specific compound key e.g. nasa-power:{grid}:{params}:{dates}']
  dataset     text        [not null, note: 'e.g. nasa-power, epa-aqs, census-acs, usgs-eq, fcc-broadband']
  input_lat   numeric
  input_lon   numeric
  result_json jsonb
  cached_at   timestamptz [default: `now()`]
  expires_at  timestamptz [note: 'NULL = no expiry. Partial index on non-null values.']

  indexes {
    expires_at [name: 'query_cache_expires_idx', note: 'WHERE expires_at IS NOT NULL']
  }

  Note: '''
    Cached results for API-based sources. TTLs by dataset:
    - nasa-power: 30 days
    - epa-aqs: 365 days
    - census-acs: 365 days
    - usgs-eq: 30 days
    - fcc-broadband: 90 days
  '''
}

Table report_archive {
  report_id            text        [pk]
  generated_at         timestamptz [default: `now()`]
  input_address        text
  lat                  numeric
  lon                  numeric
  source_versions_json jsonb       [note: 'Snapshot of data_source_registry at report generation time']
  pdf_storage_key      text        [note: 'MinIO key for the stored PDF']

  Note: 'Every generated report. source_versions_json captures data lineage for audit purposes.'
}

// ─── Phase 2: Vector Ingestion ───────────────────────────────────────────────

Table census_block_groups {
  geoid    text    [pk, note: '15-digit FIPS: state(2) + county(3) + tract(6) + blkgrp(1)']
  statefp  text    [not null]
  countyfp text    [not null]
  tractce  text    [not null]
  blkgrpce text    [not null]
  aland    bigint  [note: 'Land area in square metres']
  awater   bigint  [note: 'Water area in square metres']
  geom     geometry(MultiPolygon, 4326) [not null]

  indexes {
    geom     [type: gist, name: 'census_block_groups_geom_idx']
    (statefp, countyfp) [name: 'census_block_groups_county_idx']
  }

  Note: 'Census TIGER/Line 2023 block-group geometries for Oklahoma. ACS demographic values are stored in acs_block_group_data (migration 007) and looked up locally at query time — no Census API key required.'
}

Table census_tracts {
  geoid    text    [pk, note: '11-digit FIPS: state(2) + county(3) + tract(6)']
  statefp  text    [not null]
  countyfp text    [not null]
  tractce  text    [not null]
  aland    bigint
  awater   bigint
  geom     geometry(MultiPolygon, 4326) [not null]

  indexes {
    geom     [type: gist, name: 'census_tracts_geom_idx']
    (statefp, countyfp) [name: 'census_tracts_county_idx']
  }

  Note: 'Census TIGER/Line 2023 tract geometries. ACS values looked up locally via acs_block_group_data (no Census API).'
}

Table fema_flood_zones {
  gid         serial  [pk]
  dfirm_id    text
  fld_zone    text    [note: 'e.g. AE, X, AO, AH, VE']
  zone_subty  text
  sfha_tf     text    [note: 'T = Special Flood Hazard Area, F = non-SFHA']
  bfe_revert  numeric
  static_bfe  numeric
  county_fips text    [note: '5-digit county FIPS']
  source_date date
  geom        geometry(MultiPolygon, 4326) [not null]

  indexes {
    geom        [type: gist, name: 'fema_flood_zones_geom_idx']
    fld_zone    [name: 'fema_flood_zones_zone_idx']
    county_fips [name: 'fema_flood_zones_county_idx']
  }

  Note: 'FEMA NFHL flood-zone polygons. Delete-then-insert per county for idempotent loads.'
}

Table fema_unmapped_areas {
  county_fips text [pk, note: '5-digit county FIPS']
  geom        geometry(MultiPolygon, 4326)

  indexes {
    geom [type: gist, name: 'fema_unmapped_areas_geom_idx']
  }

  Note: '''
    County boundary minus all flood-zone polygons.
    CRITICAL: a site that falls here has NO FEMA flood mapping —
    it must NEVER silently appear as Zone X in report output.
    ~15-20% of the US has no FEMA coverage.
  '''
}

Table iecc_climate_zones {
  zone_label       text [pk, note: 'e.g. 3A, 4C, 5B']
  zone_description text
  geom             geometry(MultiPolygon, 4326) [not null, note: 'All polygons for a label unioned into one MultiPolygon']

  indexes {
    geom [type: gist, name: 'iecc_climate_zones_geom_idx']
  }

  Note: 'DOE/PNNL IECC 2021 climate zone boundaries (national). One row per zone label.'
}

Table fema_nri {
  tract_id    text    [pk, note: '11-digit census tract FIPS']
  county_fips text    [note: 'First 5 chars of tract_id']
  risk_score  numeric
  risk_ratng  text    [note: 'FEMA NRI risk rating label']
  avln_score  numeric [note: 'Avalanche']
  cfld_score  numeric [note: 'Coastal flooding']
  cwav_score  numeric [note: 'Cold wave']
  drgt_score  numeric [note: 'Drought']
  erqk_score  numeric [note: 'Earthquake']
  hail_score  numeric [note: 'Hail']
  hwav_score  numeric [note: 'Heat wave']
  hrcn_score  numeric [note: 'Hurricane']
  istm_score  numeric [note: 'Ice storm']
  lnds_score  numeric [note: 'Landslide']
  ltng_score  numeric [note: 'Lightning']
  rfld_score  numeric [note: 'Riverine flooding']
  swnd_score  numeric [note: 'Strong wind']
  trnd_score  numeric [note: 'Tornado']
  tsun_score  numeric [note: 'Tsunami']
  vlcn_score  numeric [note: 'Volcanic activity']
  wfir_score  numeric [note: 'Wildfire']
  wntw_score  numeric [note: 'Winter weather']
  geom        geometry(MultiPolygon, 4326) [note: 'Copied from census_tracts at load time; nullable']

  indexes {
    geom [type: gist, name: 'fema_nri_geom_idx', note: 'WHERE geom IS NOT NULL']
  }

  Note: '''
    FEMA National Risk Index tract-level scores.
    IMPORTANT: ALL report output using this table MUST be labeled
    "Source: FEMA National Risk Index" — this is FEMA''s composite model,
    not a Plinth-derived rating.
  '''
}

Table nhd_flowlines {
  permanent_identifier text    [pk]
  gnis_name            text
  lengthkm             numeric
  ftype                integer
  fcode                integer
  geom                 geometry(MultiLineString, 4326) [not null]

  indexes {
    geom [type: gist, name: 'nhd_flowlines_geom_idx']
  }

  Note: 'NHDPlus HR flowlines for VPU 11 (Arkansas-White-Red). Named features only (GNIS_NAME IS NOT NULL).'
}

Table nhd_waterbodies {
  permanent_identifier text    [pk]
  gnis_name            text
  areasqkm             numeric
  ftype                integer
  fcode                integer
  geom                 geometry(MultiPolygon, 4326) [not null]

  indexes {
    geom [type: gist, name: 'nhd_waterbodies_geom_idx']
  }

  Note: 'NHDPlus HR waterbodies for VPU 11. Named features only.'
}

Table ssurgo_mapunits {
  mukey  text [pk, note: 'USDA map unit key']
  musym  text
  muname text
  geom   geometry(MultiPolygon, 4326) [not null]

  indexes {
    geom [type: gist, name: 'ssurgo_mapunits_geom_idx']
  }

  Note: 'USDA SSURGO map-unit polygons for NE Oklahoma survey areas.'
}

Table ssurgo_muaggatt {
  mukey        text    [pk]
  hydgrpdcd    text    [note: 'Hydrologic soil group (A/B/C/D)']
  drclassdcd   text    [note: 'Drainage class']
  slopegraddcp numeric [note: 'Representative slope gradient (%)']
  taxclname    text    [note: 'Taxonomic classification name']
  // Extended muaggatt fields (added migration 006)
  flodfreqdcd  text    [note: 'Flood frequency (dominant condition)']
  wtdepannmin  integer [note: 'Annual minimum depth to water table (cm)']
  brockdepmin  integer [note: 'Minimum depth to bedrock (cm)']
  niccdcd      text    [note: 'Non-irrigated land capability class (1–8)']
  aws0100wta   numeric [note: 'Available water storage 0–100cm (weighted avg, inches)']
  engstafdcd   text    [note: 'Septic tank absorption field suitability (dominant condition)']
  engdwobdcd   text    [note: 'Dwellings without basement suitability (dominant condition)']
  engdwbdcd    text    [note: 'Dwellings with basement suitability (dominant condition)']
  englrsdcd    text    [note: 'Local roads and streets suitability (dominant condition)']
  forpehrtdcp  text    [note: 'Potential erosion hazard (dominant condition)']

  Note: 'SSURGO map-unit aggregated attributes (tabular — no geometry).'
}

Table ssurgo_component {
  cokey       text    [pk, note: 'USDA component key']
  mukey       text    [not null, ref: > ssurgo_mapunits.mukey]
  compname    text
  comppct_r   numeric [note: 'Representative component percentage']
  majcompflag text    [note: 'Yes/No — is this the major component?']

  indexes {
    mukey [name: 'ssurgo_component_mukey_idx']
  }

  Note: 'SSURGO soil components (tabular — no geometry). References ssurgo_mapunits.'
}

Table ssurgo_cointerp_engr {
  cokey      text    [not null, ref: > ssurgo_component.cokey]
  mukey      text    [not null, ref: > ssurgo_mapunits.mukey]
  mrulename  text    [not null, note: 'Interpretation rule name (e.g. ENG - Dwellings W/O Basements)']
  seqnum     integer [not null, note: 'Sequence: 0=overall rating, 1+=limiting factors in order']
  interphrc  text    [note: 'Rating or limiting factor text']

  indexes {
    (cokey, mrulename, seqnum) [pk]
    mukey  [name: 'ssurgo_cointerp_engr_mukey_idx']
    cokey  [name: 'ssurgo_cointerp_engr_cokey_idx']
  }

  Note: 'SSURGO component-level engineering interpretation ratings with limiting factors. seqnum=0 is the overall rating (Not limited / Somewhat limited / Very limited); seqnum≥1 are the limiting factors in order of severity (e.g. Shrink-swell, Depth to saturated zone).'
}


Table noaa_climate_normals {
  station_id  text    [pk, note: 'NOAA station identifier (e.g. USW00013967)']
  name        text    [not null, note: 'Station display name']
  elevation_m numeric [note: 'Station elevation in metres']
  geom        geometry(Point,4326) [not null]

  tmax        numeric[] [note: 'Monthly avg daily max temp °F, Jan-Dec (12-element array)']
  tmin        numeric[] [note: 'Monthly avg daily min temp °F, Jan-Dec']
  tavg        numeric[] [note: 'Monthly avg temp °F, Jan-Dec']
  prcp        numeric[] [note: 'Monthly total precipitation inches, Jan-Dec']
  snow        numeric[] [note: 'Monthly total snowfall inches, Jan-Dec']
  htdd        numeric[] [note: 'Monthly heating degree days, Jan-Dec']
  cldd        numeric[] [note: 'Monthly cooling degree days, Jan-Dec']

  indexes {
    geom [type: gist, name: 'noaa_climate_normals_geom_idx']
  }

  Note: 'NOAA 1991-2020 Climate Normals (monthly, per station). Source: NCEI bulk archive. Decadal refresh.'
}

// ─── Phase 2: FCC Broadband ───────────────────────────────────────────────────

Table fcc_broadband_coverage {
  id                       serial  [pk]
  location_id              bigint  [not null, note: 'FCC fabric location_id']
  provider_id              text    [not null, note: 'FCC provider (FRN)']
  brand_name               text
  technology_code          integer [not null, note: '10=Copper, 40=Cable, 50=Fiber, 70=Unlicensed FW, 71=Licensed FW, 72=LBR FW (60/61 satellite excluded)']
  max_download_mbps        integer
  max_upload_mbps          integer
  low_latency              boolean
  business_residential_code text   [note: 'R=Residential, B=Business, X=Both']
  block_geoid              text    [not null, note: '15-digit census block GEOID; LEFT(block_geoid,12) = block group GEOID']
  state_fips               text    [not null, note: '2-digit state FIPS']
  as_of_date               date    [not null, note: 'FCC filing period date (e.g. 2025-06-30)']

  indexes {
    (location_id, provider_id, technology_code) [unique, name: 'fcc_broadband_coverage_unique_idx']
    block_geoid [name: 'fcc_broadband_coverage_block_geoid_idx']
    location_id [name: 'fcc_broadband_coverage_location_id_idx']
    state_fips  [name: 'fcc_broadband_coverage_state_fips_idx']
  }

  Note: 'FCC BDC State/Location Coverage — Fixed Broadband (R+B+X; all service types). Source: bdc.fcc.gov Public Data API. Semi-annual refresh. Spatial lookup: ST_Contains on census_block_groups → LEFT(block_geoid,12) join. Satellite (GSO/NGSO) excluded.'
}

// ─── Cross-table references ───────────────────────────────────────────────────

Ref: fema_nri.tract_id - census_tracts.geoid
Ref: fema_flood_zones.county_fips > fema_unmapped_areas.county_fips

// ─── Migration 007: API-to-Local Bulk Storage ─────────────────────────────────
// These tables replace seven runtime API dependencies with locally-ingested data.
// USDA WHP and USGS Seismic rasters are COGs in MinIO; indexed via raster_tiles.

Table acs_block_group_data {
  geoid    char(12) [not null, note: '12-digit block group GEOID (state+county+tract+bg)']
  acs_year smallint [not null, note: 'ACS 5-year vintage end year (e.g. 2023 = 2019-2023)']

  // Population & Age (B01001, B01002, B01003)
  total_population   numeric
  median_age         numeric
  median_age_male    numeric
  median_age_female  numeric
  avg_household_size numeric
  male_total         numeric
  female_total       numeric
  // ... plus 22 male age brackets, 22 female age brackets (m_under5 … m_85plus, f_under5 … f_85plus)
  // ... Households & Income (B11001, B19013, B19301, C17002, B19057)
  total_households        numeric
  median_hhi              numeric
  per_capita_income       numeric
  poverty_universe        numeric
  poverty_under_050       numeric
  poverty_050_099         numeric
  public_assistance_count numeric
  // ... Housing (B25001, B25077, B25064, B25002, B25035)
  total_housing_units  numeric
  median_home_value    numeric
  median_gross_rent    numeric
  vacant_units         numeric
  median_year_built    numeric
  owner_occupied       numeric
  renter_occupied      numeric
  // ... Education (B15003), Commute (B08303, B08301), Employment (B23025)
  // ... Occupation (C24010), Industry (C24030), Race (B03002), Language (C16002)
  // All 148 ACS estimate variables stored with corresponding _moe columns (296 total).

  indexes {
    (geoid, acs_year) [pk]
    geoid [name: 'acs_bg_data_geoid_idx']
  }

  Note: '''
    Census ACS 5-Year Estimates — all US block groups (~242k), loaded from
    pre-built Summary File .dat archives (no API key required).
    296 columns total: 148 estimate variables + 148 MOE columns.
    Refreshed annually via ingest-census-acs-bulk.
    Cross-references census_block_groups.geoid for geometry.
  '''
}

Table epa_aqs_sites {
  site_id         text    [pk, note: 'state_code || county_code || site_num (9 chars)']
  state_code      text
  county_code     text
  site_num        text
  local_site_name text
  address         text
  city            text
  county_name     text
  state_name      text
  latitude        numeric
  longitude       numeric
  geom            geometry(Point, 4326) [not null]

  indexes {
    geom [type: gist, name: 'epa_aqs_sites_geom_idx']
  }

  Note: 'EPA AQS monitoring site registry. Derived from the annual summary CSV headers. Spatial index enables ST_DWithin nearest-monitor lookup.'
}

Table epa_aqs_annual_summary {
  id                     bigserial [pk]
  site_id                text      [not null, ref: > epa_aqs_sites.site_id]
  year                   smallint  [not null]
  parameter_code         text      [not null]
  parameter_name         text
  pollutant_standard     text
  units                  text
  arithmetic_mean        numeric
  first_max_value        numeric
  first_max_hour         integer
  second_max_value       numeric
  third_max_value        numeric
  fourth_max_value       numeric
  ninety_eighth_pctile   numeric
  ninety_ninth_pctile    numeric
  aqi                    integer
  method_code            text
  method_name            text
  observation_count      integer
  observation_percent    numeric
  valid_day_count        integer
  required_day_count     integer
  exceptional_data_count integer

  indexes {
    (site_id, year, parameter_code, pollutant_standard) [unique, name: 'epa_aqs_summary_unique']
    (site_id, year) [name: 'epa_aqs_summary_site_year_idx']
    (parameter_code, year) [name: 'epa_aqs_summary_param_idx']
  }

  Note: 'EPA AQS annual pollutant summary. One row per site × year × parameter × pollutant standard. Loaded from pre-built annual_conc_by_monitor_YYYY.zip (no API key). 5 years loaded (~297k rows). Refreshed annually.'
}


Table nasa_power_climatology {
  grid_lat           numeric(5,2) [not null, note: 'SW corner of 0.5° POWER grid cell']
  grid_lon           numeric(6,2) [not null, note: 'SW corner of 0.625° POWER grid cell']
  month              smallint     [not null, note: '0=annual average, 1–12=monthly climatology']
  t2m_mean_c         numeric      [note: 'Air temperature at 2m mean (°C)']
  t2m_max_c          numeric      [note: 'Air temperature at 2m max (°C)']
  t2m_min_c          numeric      [note: 'Air temperature at 2m min (°C)']
  t2mdew_c           numeric      [note: 'Dew point at 2m (°C)']
  t2mwet_c           numeric      [note: 'Wet bulb temperature at 2m (°C)']
  rh2m_pct           numeric      [note: 'Relative humidity at 2m (%)']
  prectotcorr_mm_day numeric      [note: 'Precipitation corrected (mm/day)']
  ws10m_m_s          numeric      [note: 'Wind speed at 10m (m/s)']
  ws50m_m_s          numeric      [note: 'Wind speed at 50m (m/s)']
  allsky_sfc_sw_dwn  numeric      [note: 'All-sky surface shortwave irradiance (kWh/m²/day)']
  allsky_kt          numeric      [note: 'All-sky insolation clearness index']
  clrsky_sfc_sw_dwn  numeric      [note: 'Clear-sky surface shortwave irradiance (kWh/m²/day)']
  allsky_sfc_lw_dwn  numeric      [note: 'All-sky surface longwave irradiance (kWh/m²/day)']
  hdd18_3            numeric      [note: 'Heating degree days (base 18.3°C)']
  cdd18_3            numeric      [note: 'Cooling degree days (base 18.3°C)']

  indexes {
    (grid_lat, grid_lon, month) [pk]
  }

  Note: '20-year monthly climatology from NASA POWER MERRA-2/CERES SYN1deg. Grid: 0.5° lat × 0.625° lon. month=0 is annual average. 13 rows per grid cell (annual + 12 months). Loaded from NASA POWER Regional API (no API key). ~45 cells for NE Oklahoma.'
}

Table usgs_earthquake_events {
  event_id       text        [pk, note: 'USGS ComCat event ID (e.g. "us7000aabc")']
  occurred_at    timestamptz [not null]
  magnitude      numeric
  magnitude_type text
  depth_km       numeric
  place          text
  status         text        [note: '"reviewed" | "automatic"']
  gap            numeric     [note: 'Azimuthal gap (degrees)']
  rms            numeric     [note: 'Root-mean-square travel-time residual']
  nst            integer     [note: 'Number of seismic stations used']
  url            text
  geom           geometry(Point, 4326) [not null]

  indexes {
    geom        [type: gist, name: 'usgs_eq_geom_idx']
    occurred_at [name: 'usgs_eq_occurred_idx']
    magnitude   [name: 'usgs_eq_mag_idx']
  }

  Note: 'USGS ComCat earthquake catalog. M≥2.0 events within NE Oklahoma bounding box +1° buffer. Loaded from USGS FDSN event API (single bulk CSV export). 12,916 events loaded (1918–2026). Queried at report time via ST_DWithin with 80km radius, M≥3.0, last 50 years.'
}

// ============================================================
// EIA Power Plants  (migration 010)
// ============================================================

Table eia_power_plants {
  plant_id             integer   [pk, note: 'EIA Plant Code']
  plant_name           text      [not null]
  utility_id           integer   [note: 'EIA Utility ID — joins to electric_service_territories.eia_id']
  utility_name         text
  operator_name        text
  state                char(2)
  county               text
  lat                  numeric(9,6)
  lon                  numeric(9,6)
  geom                 geometry(Point, 4326)
  install_year         smallint
  data_year            smallint  [not null]
  capacity_mw_total    numeric   [note: 'Sum of all generator nameplate capacity (MW)']
  capacity_mw_by_fuel  jsonb     [note: '{"NG": 450.0, "SUN": 200.0, ...} — sum by EIA fuel code']
  primary_fuel         text      [note: 'EIA fuel code of highest-capacity generator']
  technology_types     text[]    [note: 'Distinct technology types at this plant']
  operating_status     text      [note: 'OP=operating, RE=retired, SB=standby, CN=construction']
  created_at           timestamptz [default: `now()`]
  updated_at           timestamptz [default: `now()`]

  indexes {
    geom           [type: gist, name: 'idx_eia_plants_geom']
    primary_fuel   [name: 'idx_eia_plants_fuel']
    operating_status [name: 'idx_eia_plants_status']
  }

  Note: 'EIA-860 Annual Electric Generator Report aggregated to plant level. ~10k plants nationally. Loaded annually from EIA-860 ZIP (eia.gov). Joined to electric_service_territories via utility_id for utility attribution.'
}

// ============================================================
// HIFLD Electric Service Territories  (migration 010)
// ============================================================

Table electric_service_territories {
  id          serial   [pk]
  eia_id      text     [note: 'EIA utility ID — joins to eia_power_plants.utility_id']
  utility_name text    [not null]
  state       char(2)
  naics_code  text
  entity_type text     [note: 'IOU=investor-owned, COOP=cooperative, MUN=municipal, FED=federal, OTHER']
  address     text
  city        text
  zip         text
  phone       text
  geom        geometry(MultiPolygon, 4326) [not null]
  source_date text
  created_at  timestamptz [default: `now()`]

  indexes {
    geom   [type: gist, name: 'idx_service_territories_geom']
    eia_id [name: 'idx_service_territories_eia_id']
  }

  Note: 'HIFLD Electric Retail Service Territories. ~3,200 utility service area polygons (IOUs, co-ops, municipals, public power). ST_Contains(geom, site_point) identifies the serving utility. Joined to eia_power_plants via eia_id. Updated annually from HIFLD ArcGIS FeatureServer.'
}

// ============================================================
// HIFLD Transmission Lines  (migration 010)
// ============================================================

Table electric_transmission_lines {
  id            serial  [pk]
  line_name     text
  owner         text
  voltage_kv    integer [note: 'Nominal voltage in kilovolts']
  voltage_class text    [note: 'HIFLD voltage class: "100-161", "230", "345", "500", "735 And Above", etc.']
  status        text    [note: '"IN SERVICE", "UNDER CONSTRUCTION", "PROPOSED", etc.']
  geom          geometry(MultiLineString, 4326) [not null]
  source_date   text
  created_at    timestamptz [default: `now()`]

  indexes {
    geom      [type: gist, name: 'idx_transmission_lines_geom']
    voltage_kv [name: 'idx_transmission_lines_voltage']
  }

  Note: 'HIFLD Electric Transmission Lines. ~70k line segments, 69kV and above. ST_DWithin used to find nearest line and voltage class. Updated annually from HIFLD ArcGIS FeatureServer.'
}

// ============================================================
// HIFLD Electric Substations  (migration 010)
// ============================================================

Table electric_substations {
  id          serial  [pk]
  name        text
  owner       text
  city        text
  state       char(2)
  status      text    [note: '"IN SERVICE", "UNDER CONSTRUCTION", etc.']
  lines       integer [note: 'Number of transmission/distribution lines at substation']
  max_volt    integer [note: 'Maximum voltage (kV)']
  min_volt    integer [note: 'Minimum voltage (kV)']
  geom        geometry(Point, 4326) [not null]
  source_date text
  created_at  timestamptz [default: `now()`]

  indexes {
    geom [type: gist, name: 'idx_substations_geom']
  }

  Note: 'HIFLD Electric Substations. ~80k substation points (69kV+). Updated annually from HIFLD ArcGIS FeatureServer.'
}

// ============================================================
// EPA SDWIS Water Systems  (migration 011)
// ============================================================

Table sdwis_water_systems {
  pwsid               text    [pk, note: 'EPA Public Water System ID (e.g. OK3000001)']
  pws_name            text    [not null]
  pws_type_code       text    [note: 'CWS=community, NTNC=non-transient non-community']
  primary_source      text    [note: 'GW=groundwater, SW=surface water, GU=groundwater under surface influence']
  owner_type_code     text    [note: 'F=federal, L=local govt, M=municipal, N=nonprofit, P=private, S=state']
  population_served   integer
  service_connections integer
  state_code          char(2)
  primary_county      text
  city_served         text
  zip_codes           text[]  [note: 'ZIP codes in service area from GEOGRAPHIC_AREA.CSV']
  counties_served     text[]  [note: 'County FIPS codes served, from SERVICE_AREA.CSV']
  activity_code       text    [note: 'A=active, I=inactive']
  violation_count_5yr integer [default: 0, note: 'Health-based violation count, last 5 years']
  data_quarter        text    [note: 'SDWIS reporting quarter, e.g. "2025Q4"']
  created_at          timestamptz [default: `now()`]
  updated_at          timestamptz [default: `now()`]

  indexes {
    state_code      [name: 'idx_sdwis_state']
    pws_type_code   [name: 'idx_sdwis_type']
    primary_source  [name: 'idx_sdwis_source']
    counties_served [type: gin, name: 'idx_sdwis_county']
  }

  Note: 'EPA SDWIS public water system registry via ECHO bulk download. CWS and NTNC systems only (~150k systems). Refreshed monthly. Join to water_system_boundaries via pwsid for spatial lookup.'
}

// ============================================================
// EPA CWS Service Area Boundaries  (migration 011)
// ============================================================

Table water_system_boundaries {
  id              serial  [pk]
  pwsid           text    [not null, ref: > sdwis_water_systems.pwsid, note: 'Joins to sdwis_water_systems']
  pws_name        text
  boundary_source text    [note: '"state_supplied", "epa_modeled", "utility_supplied"']
  state_code      char(2)
  geom            geometry(MultiPolygon, 4326) [not null]
  source_date     text
  created_at      timestamptz [default: `now()`]

  indexes {
    geom  [type: gist, name: 'idx_water_boundaries_geom']
    pwsid [name: 'idx_water_boundaries_pwsid']
  }

  Note: 'EPA CWS Service Area Boundaries. ~44k polygon boundaries (~99% consumer coverage). ST_Contains(geom, site_point) identifies the serving water system. Join via pwsid to sdwis_water_systems for system metadata. Updated annually from EPA ArcGIS FeatureServer.'
}

// ============================================================
// USGS Principal Aquifers  (migration 012)
// ============================================================

Table usgs_principal_aquifers {
  id           serial  [pk]
  aq_name      text    [not null, note: 'Aquifer formation name, e.g. "High Plains aquifer"']
  aq_code      text    [note: 'USGS aquifer code']
  rock_type    text    [note: 'Formation rock type description']
  aquifer_type text    [note: 'Classification: unconsolidated sand and gravel / semiconsolidated / sandstone / carbonate / other']
  geom         geometry(MultiPolygon, 4326) [not null]
  created_at   timestamptz [default: `now()`]

  indexes {
    geom [type: gist, name: 'idx_aquifers_geom']
  }

  Note: 'USGS Ground Water Atlas principal aquifer polygons. ~70 formation polygons at 1:2,500,000 national scale. ST_Intersects identifies the principal aquifer underlying any site. Note: national-scale data; local conditions vary significantly within each formation boundary.'
}

// ============================================================
// USGS NWIS Groundwater Monitoring Wells  (migration 012)
// ============================================================

Table usgs_groundwater_wells {
  site_no          text    [pk, note: 'USGS site number']
  station_nm       text
  state_cd         char(2)
  county_cd        text
  aquifer_cd       text    [note: 'USGS local aquifer code']
  nat_aqfr_cd      text    [note: 'USGS national aquifer code — cross-references usgs_principal_aquifers']
  well_depth_ft    numeric [note: 'Total well depth (ft)']
  hole_depth_ft    numeric
  geom             geometry(Point, 4326) [not null]
  dtw_median_ft    numeric [note: 'Median depth to water below land surface (ft), parameter 72019']
  dtw_mean_ft      numeric
  dtw_min_ft       numeric [note: 'Shallowest recorded depth to water (ft below land surface)']
  dtw_max_ft       numeric [note: 'Deepest recorded depth to water (ft below land surface)']
  dtw_obs_count    integer [note: 'Number of depth-to-water observations used in statistics']
  dtw_period_start date    [note: 'Start of period of record for depth-to-water data']
  dtw_period_end   date
  created_at       timestamptz [default: `now()`]
  updated_at       timestamptz [default: `now()`]

  indexes {
    geom        [type: gist, name: 'idx_gw_wells_geom']
    nat_aqfr_cd [name: 'idx_gw_wells_aquifer']
    state_cd    [name: 'idx_gw_wells_state']
  }

  Note: '~914k USGS NWIS groundwater monitoring sites with pre-aggregated depth-to-water statistics (parameter 72019, ft below land surface). State-by-state download from waterservices.usgs.gov. Only ~142 sites nationally have approved daily-value records for pre-computed stats; dtw_* = NULL for the rest. Recent discrete readings in usgs_groundwater_well_readings. Updated annually.'
}

Table usgs_groundwater_well_readings {
  id             serial      [pk]
  site_no        text        [not null, ref: > usgs_groundwater_wells.site_no, note: 'FK to usgs_groundwater_wells; CASCADE DELETE']
  lev_dt         date        [not null, note: 'Date of measurement']
  lev_va         numeric     [note: 'Depth to water, ft below land surface (positive = deeper); NULL for Dry/NoMeasurement readings']
  parameter_code text        [note: 'USGS OGC API parameter code: 72019=standard DTW, 62610=calib electric tape, 62611=analog recorder, 72150=alt electric tape']
  qualifier      text        [note: 'USGS OGC API qualifier: Static, Dry, Pumping, Flowing, Frozen, Obstructed, GWSWAffected, GWTideAffected, Saline, Revised, etc.']
  created_at     timestamptz [default: `now()`]

  indexes {
    site_no                      [name: 'idx_gw_readings_site']
    (lev_dt)                     [name: 'idx_gw_readings_date']
    (site_no, lev_dt, qualifier) [unique, name: 'uq_gw_readings_site_date_qual']
  }

  Note: 'All discrete groundwater level readings for the past 3 years per well, from api.waterdata.usgs.gov OGC field-measurements API. All four depth-to-water parameter codes (72019, 62610, 62611, 72150) are fetched. All readings retained regardless of qualifier so users can see Dry/Pumping/Flowing conditions. Source: USGS NWIS OGC API.'
}

// ============================================================
// USGS Hydrogeologic Framework (migration 017)
// ============================================================

Table usgs_hydrogeologic_provinces {
  id          serial  [pk]
  prov_name   text    [not null, note: 'e.g. "Coastal Plain", "Central Interior", "Basin and Range and Rio Grande Rift"']
  geom        geometry(MultiPolygon, 4326) [not null]
  source_year smallint [default: 2025]
  created_at  timestamptz [default: `now()`]

  indexes {
    geom [type: gist, name: 'idx_hydro_provinces_geom']
  }

  Note: '8 broad hydrogeologic provinces covering all CONUS. Source: USGS ScienceBase item 6807cab6d4be020d8168d576 (published 2025-07-28). NAD83(2011)/Conus Albers reprojected to EPSG:4326 on load.'
}

Table usgs_hydrogeologic_regions {
  id          serial  [pk]
  reg_name    text    [not null, note: 'e.g. "High Plains aquifer", "Nebraska Sand Hills"']
  reg_code    text    [note: 'USGS national aquifer code, e.g. "N100HGHPLN"']
  reg_type    text    [note: '"PA" = Principal Aquifer; "SHR" = Secondary Hydrogeologic Region (fills unmapped gaps)']
  lithology   text    [note: 'e.g. "Unconsolidated sand and gravel aquifers", "Carbonate-rock aquifers"']
  geom        geometry(MultiPolygon, 4326) [not null]
  source_year smallint [default: 2025]
  created_at  timestamptz [default: `now()`]

  indexes {
    geom     [type: gist, name: 'idx_hydro_regions_geom']
    reg_type [name: 'idx_hydro_regions_type']
  }

  Note: '126 named hydrogeologic regions covering all CONUS with no gaps: 57 Principal Aquifer (PA) polygons + 69 Secondary Hydrogeologic Regions (SHR) that fill unmapped areas. Together with provinces provides full CONUS hydrogeologic context. Source: USGS ScienceBase item 6863356fd4be025653d31f4d (published 2025-12-19).'
}
