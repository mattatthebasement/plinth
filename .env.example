# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plinth
POSTGRES_USER=plinth
POSTGRES_PASSWORD=changeme_postgres

# ============================================================
# MinIO (S3-compatible object storage)
# ============================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=plinth
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET_RASTERS=plinth-rasters
MINIO_SECURE=false

# ============================================================
# Prefect
# ============================================================
PREFECT_API_URL=http://prefect-server:4200/api

# ============================================================
# API Keys
# ============================================================

# Mapbox — geocoding + static map images
# Free tier: 100k requests/month. Get a token at account.mapbox.com
MAPBOX_TOKEN=pk.eyJ1...your_token_here

# US Census Bureau — ACS 5-year demographic data
# Register free at: api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_key_here

# EPA AQS — air quality monitor data
# Email aqsdatamart@epa.gov with subject "AQS Data Mart account" to register
EPA_AQS_KEY=your_epa_aqs_key_here
EPA_AQS_EMAIL=your_email@example.com

# ============================================================
# Regional scope (NE Oklahoma for POC — expand as needed)
# ============================================================
REGION_BBOX_MINX=-96.5
REGION_BBOX_MINY=35.5
REGION_BBOX_MAXX=-94.5
REGION_BBOX_MAXY=37.0

# ============================================================
# Internal paths
# ============================================================
# Staging directory for downloaded source files (inside container)
STAGING_DIR=/staging
